wilcox.test(as.numeric(as.character(EDSS_T0)) ~ smoking_habit, data = merged_data, exact = FALSE) # differenza non significativa
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ smoking_habit, data = merged_data, exact = FALSE) # differenza non significativa
ggplot(subset(merged_data, !is.na(smoking_habit) & !is.na(EDSS_T0)), aes(x = smoking_habit, y = as.numeric(as.character(EDSS_T0)), fill = smoking_habit)) + geom_boxplot(alpha = 0.8) + theme_minimal() + labs(title = "EDSS vs Smoking habit", x = "Smoking habit", y = "EDSS T0")
## EDSS vs physical_activity
#T0
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ physical_activity, data = merged_data)
ggplot(subset(merged_data, !is.na(physical_activity) & !is.na(EDSS_T0)), aes(x = physical_activity, y = as.numeric(as.character(EDSS_T0)), fill = physical_activity)) + geom_boxplot() + theme_minimal() + labs(title = "EDSS vs Physical_activity", x = "Physical_activity", y = "EDSS_T0")
kruskal.test(as.numeric(as.character(EDSS_T6)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T12)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T18)) ~ physical_activity, data = merged_data)
#T24
kruskal.test(as.numeric(as.character(EDSS_T24)) ~ physical_activity, data = merged_data)
ggplot(subset(merged_data, !is.na(physical_activity) & !is.na(EDSS_T24)), aes(x = physical_activity, y = as.numeric(as.character(EDSS_T24)), fill = physical_activity)) + geom_boxplot() + theme_minimal() + labs(title = "EDSS vs Physical_activity", x = "Physical_activity", y = "EDSS_T24")
kruskal.test(as.numeric(as.character(EDSS_T30)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T36)) ~ physical_activity, data = merged_data)
#andamento totale
edss_long <- merged_data %>%
select(ID, smoking_habit, sex, naive, physical_activity, EDSS_T0, EDSS_T6, EDSS_T12, EDSS_T18, EDSS_T24, EDSS_T30) %>%
pivot_longer(cols = starts_with("EDSS"), names_to = "time", values_to = "EDSS_val") %>%
mutate(EDSS_val = as.numeric(as.character(EDSS_val)), sex = trimws(as.character(sex)), time = factor(time, levels = c("EDSS_T0","EDSS_T6","EDSS_T12","EDSS_T18","EDSS_T24","EDSS_T30"))) %>%
filter(!is.na(EDSS_val))
ggplot(edss_long, aes(x = time, y = EDSS_val, color = physical_activity, group = physical_activity)) +
stat_summary(fun = median, geom = "line", linewidth = 1.2, na.rm = TRUE) +
stat_summary(fun = median, geom = "point", size = 3, na.rm = TRUE) +
theme_minimal() + labs(title="EDSS during time by Physical Activity", x = "Time", y = "Median EDSS")
merged_data$MEDAS_class <- factor(case_when(
merged_data$MEDAS < 40 ~ "Low_adherence",
merged_data$MEDAS >= 40 & merged_data$MEDAS < 60 ~ "Moderate_adherence",
merged_data$MEDAS >= 60 ~ "High_adherence",
TRUE ~ NA_character_),
levels = c("Low_adherence", "Moderate_adherence", "High_adherence"),ordered = TRUE)
ggplot(merged_data, aes(x = MEDAS_class)) + geom_bar(fill = "#4C78A8", color = "white") + theme_minimal() + labs(title = "MEDAS adherence categories", x = "Adherence level", y = "Frequency")
# EDSS vs MEDAS
cor.test(merged_data$MEDAS, as.numeric(merged_data$EDSS_T0), method = "spearman", exact = FALSE)
cor.test(merged_data$MEDAS, as.numeric(merged_data$EDSS_T12), method = "spearman", exact = FALSE)
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ MEDAS, data = merged_data)
# age_at_t0 vs relapse
t.test(age_at_t0 ~ relapse_T6, data = merged_data)
t.test(age_at_t0 ~ relapse_T24, data = merged_data)
# age_at_t0 vs lesions
t.test(age_at_t0 ~ lesioni_T6, data = merged_data) # correlazione SIGNIFICATIVA (di poco)
t.test(age_at_t0 ~ lesioni_T12, data = merged_data) # correlazione SIGNIFICATIVA
t.test(age_at_t0 ~ lesioni_T24, data = merged_data) # correlazione non significativa
#lesion burden
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ lesion_burden, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ lesion_burden, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T0), !is.na(lesion_burden)) %>%
mutate(
EDSS_T0 = as.factor(EDSS_T0),
lesion_burden = factor(lesion_burden, labels = c("No", "Yes"))) %>%
ggplot(aes(x = lesion_burden, fill = EDSS_T0)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T0 by lesion burden", x = "Lesion burden", y = "Percentage", fill = "EDSS")
#Bone marrow lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T0), !is.na(bone_marrow_lesions)) %>%
mutate(
EDSS_T0 = as.factor(EDSS_T0),
bone_marrow_lesions = factor(bone_marrow_lesions, labels = c("No", "Yes"))) %>%
ggplot(aes(x = bone_marrow_lesions, fill = EDSS_T0)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T0 by bone marrow lesions", x = "Bone marrow lesions", y = "Percentage", fill = "EDSS")
#subtentorial lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
#gadolinium contrast
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
#glucocorticoid treatment before T0 e edss T0 #SIGNIFICATIVO
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gc_treatment, data = merged_data)
ggplot(merged_data, aes(x = gc_treatment, y = as.numeric(as.character(EDSS_T0)))) + geom_boxplot() + theme_minimal() + labs(title= "Glucocorticoid treatment before T0", x= "gc treatment", y="EDSS T0")
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T6)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T12)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T18)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T24)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T30)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T36)) ~ MEDAS, data = merged_data)
source("Libraries.R")
metadata_pazienti_lesioni <- read_excel("Input/metadati_pazienti_Alessandro.xlsx")
metadata_paper <- read.csv("Input/metadata_paper.csv")
dati_filtrati_pazienti <- metadata_pazienti_lesioni[startsWith(metadata_pazienti_lesioni$ID, "MAV"), ]
# metto le date come date anno-mese-giorno
str(dati_filtrati_pazienti)
# queste sono le date in chr
dati_filtrati_pazienti$data_prelievo_T0 <- as.numeric(dati_filtrati_pazienti$data_prelievo_T0)
dati_filtrati_pazienti$data_prelievo_T0 <- as.Date(dati_filtrati_pazienti$data_prelievo_T0, origin = "1899-12-30")
dati_filtrati_pazienti$data_referto_T12 <- as.numeric(dati_filtrati_pazienti$data_referto_T12)
dati_filtrati_pazienti$data_referto_T12 <- as.Date(dati_filtrati_pazienti$data_referto_T12, origin = "1899-12-30")
dati_filtrati_pazienti$data_referto_T24 <- as.numeric(dati_filtrati_pazienti$data_referto_T24)
dati_filtrati_pazienti$data_referto_T24 <- as.Date(dati_filtrati_pazienti$data_referto_T24, origin = "1899-12-30")
dati_filtrati_pazienti$data_cambio_terapia <- as.numeric(dati_filtrati_pazienti$data_cambio_terapia)
dati_filtrati_pazienti$data_cambio_terapia <- as.Date(dati_filtrati_pazienti$data_cambio_terapia, origin = "1899-12-30")
# queste sono le date in posixct
dati_filtrati_pazienti$`data di nascita` <- as.Date(dati_filtrati_pazienti$`data di nascita`)
dati_filtrati_pazienti$data_referto_T6 <- as.Date(dati_filtrati_pazienti$data_referto_T6)
dati_filtrati_pazienti$data_referto_T18 <- as.Date(dati_filtrati_pazienti$data_referto_T18)
dati_filtrati_pazienti$data_referto_T30 <- as.Date(dati_filtrati_pazienti$data_referto_T30)
dati_filtrati_pazienti$data_referto_T36 <- as.Date(dati_filtrati_pazienti$data_referto_T36)
# date numeriche
dati_filtrati_pazienti$`DATA ESORDIO` <- as.Date(dati_filtrati_pazienti$`DATA ESORDIO`, origin = "1899-12-30")
dati_filtrati_pazienti$data_diagnosi <- as.Date(dati_filtrati_pazienti$data_diagnosi, origin = "1899-12-30")
# modifico le variabili non corrette
str(dati_filtrati_pazienti)
dati_filtrati_pazienti$EDSS_T24 <- as.numeric(dati_filtrati_pazienti$EDSS_T24)
dati_filtrati_pazienti$EDSS_T12 <- as.numeric(dati_filtrati_pazienti$EDSS_T12)
cols <- c("lesioni_T6", "relapse_T6", "lesioni_T12", "relapse_T12", "lesioni T18", "lesioni T24", "relapse T24", "lesioni T30", "relapse T30", "lesioni T36", "relapse T36", "relapse T18", "cambio_terapia")
dati_filtrati_pazienti[cols] <- lapply(dati_filtrati_pazienti[cols], factor, levels = c(0, 1))
# trasformo ? in NA
# sostituire "?" con NA in tutte le colonne
dati_filtrati_pazienti$EDSS_T24 <- as.numeric(
ifelse(
as.character(dati_filtrati_pazienti$EDSS_T24) == "?", # se è "?"
NA, # sostituisci con NA
dati_filtrati_pazienti$EDSS_T24 # altrimenti tieni il valore
)
)
summary(dati_filtrati_pazienti$EDSS_T24)
dati_filtrati_pazienti$EDSS_T12 <- as.numeric(
ifelse(
as.character(dati_filtrati_pazienti$EDSS_T12) == "?", # se è "?"
NA, # sostituisci con NA
dati_filtrati_pazienti$EDSS_T12 # altrimenti tieni il valore
)
)
# cambio nome alle colonne
names(dati_filtrati_pazienti)[names(dati_filtrati_pazienti) == "data di nascita"] <- "Data_di_nascita"
names(dati_filtrati_pazienti)[names(dati_filtrati_pazienti) == "DATA ESORDIO"] <- "Data_esordio"
names(dati_filtrati_pazienti)[names(dati_filtrati_pazienti) == "data_diagnosi"] <- "Data_diagnosi"
names(dati_filtrati_pazienti)[names(dati_filtrati_pazienti) == "data_prelievo_T0"] <- "Data_prelievo_T0"
# sostituisco tutti gli spazi dei nomi con underscore
names(dati_filtrati_pazienti) <- gsub(" ", "_", names(dati_filtrati_pazienti))
names(dati_filtrati_pazienti)[names(dati_filtrati_pazienti) == "nuova_TERAPIA"] <- "nuova_terapia"
#-----------------------------------------
# modifico metadata_paper
names(metadata_paper)[names(metadata_paper) == "id"] <- "ID"
names(metadata_paper)[names(metadata_paper) == "disease_actvity"] <- "disease_activity"
# estraggo solo MAV
metadata_MAV_paper <- metadata_paper[startsWith(metadata_paper$ID, "MAV"), ]
str(metadata_MAV_paper)
# trasformo simplified_batch in livelli corretti
metadata_MAV_paper$simplified_batch[metadata_MAV_paper$simplified_batch == "3-Jan"] <- "1-3"
metadata_MAV_paper$simplified_batch[metadata_MAV_paper$simplified_batch == "5-Apr"] <- "4-5"
metadata_MAV_paper$simplified_batch <- factor(metadata_MAV_paper$simplified_batch, levels = c("1-3", "4-5"))
metadata_MAV_paper$sex <- factor(metadata_MAV_paper$sex, levels = c("M", "F"))
metadata_MAV_paper$physical_activity <- factor(metadata_MAV_paper$physical_activity, levels = c("active", "sedentary", "partially_active"))
metadata_MAV_paper$disease_activity <- factor(metadata_MAV_paper$disease_activity, levels = c("higher_activity", "lower_activity"))
#uso codice suggerito da Dora
metadata_MAV_paper <- metadata_MAV_paper %>%
mutate(
across(c(age, sequencing_batch, days_gc_collection),
as.numeric),
across(c(naive, smoking_habit, antibiotic_use, spike_in),
~ factor(.x,
levels = c("yes", "no"),
labels = c("Yes", "No"))),
across(c(glucocorticoid_treatment, gc_treatment, prognosis_at_onset),
~ factor(.x,
levels = c("positive", "negative"),
labels = c("Positive", "Negative"))),
across(c(lesion_burden, bone_marrow_lesions, subtentorial_lesions,
gadolinium_contrast, full_recovery,
new_lesions_t12, relapse_t12,
new_lesions_t24, relapse_t24,
therapy_change),
~ factor(.x,
levels = c("0", "1"),
labels = c("No", "Yes")))
)
str(metadata_MAV_paper)
# cambio date con aa/m/gg
metadata_MAV_paper$sample_collection_date <- as.Date(metadata_MAV_paper$sample_collection_date, format = "%m/%d/%y")
# elimino colonne doppie
metadata_MAV_paper <- metadata_MAV_paper %>%
select(-c(
X, category, edss, edss_t0, edss_t12, edss_t24,
onset_date, diagnosis_date,
new_lesions_t12, relapse_t12,
new_lesions_t24, relapse_t24,
medas_percent, therapy_change, pyr_mds,center
))
names(metadata_MAV_paper)
# cambio nome ID in modo che coincidano
metadata_MAV_paper$ID <- sub("T0$", "", metadata_MAV_paper$ID)
# merge dei dataset
merge_metadata <- merge(dati_filtrati_pazienti, metadata_MAV_paper, by = "ID", all.x = TRUE)
names(merge_metadata)
str(merge_metadata)
binary_cols_01 <- c(
"lesioni_T6", "relapse_T6", "lesioni_T12", "relapse_T12",
"lesioni_T18", "lesioni_T24", "relapse_T24",
"lesioni_T30", "relapse_T30",
"lesioni_T36", "relapse_T36",
"relapse_T18", "cambio_terapia"
)
merge_metadata[binary_cols_01] <- lapply(
merge_metadata[binary_cols_01],
function(x) factor(as.character(x),
levels = c("0", "1"),
labels = c("No", "Yes"))
)
# cambio glc_date
merge_metadata$glc_date_before_t0 <- as.Date(merge_metadata$glc_date_before_t0, format = "%m/%d/%y")
# modifico MAV07 come non naive
merge_metadata[merge_metadata$ID == "MAV07", "naive"] <- "No"
merge_metadata[merge_metadata$ID == "MAV27", "naive"] <- "No"
# modifico la colonna therapy completandola poichè ho solo MAV
merge_metadata$therapy <- "cladribine"
# completo la colonna sex
merge_metadata$ID[is.na(merge_metadata$sex)] # per sapere chi sono gli NA
merge_metadata[merge_metadata$ID %in% c("MAV07", "MAV12", "MAV15", "MAV16", "MAV20", "MAV23", "MAV24", "MAV25", "MAV31"), "sex"] <- "F"
merge_metadata[merge_metadata$ID %in% c("MAV08", "MAV22"), "sex"] <- "M"
merge_metadata[, c("ID", "sex")] # per controllare
# completo la colonna age (at t0)
merge_metadata$ID[is.na(merge_metadata$age)]
merge_metadata[merge_metadata$ID == "MAV07", "age"] <- 42
merge_metadata[merge_metadata$ID == "MAV08", "age"] <- 36
merge_metadata[merge_metadata$ID == "MAV12", "age"] <- 36
merge_metadata[merge_metadata$ID == "MAV15", "age"] <- 48
merge_metadata[merge_metadata$ID == "MAV16", "age"] <- 55
merge_metadata[merge_metadata$ID == "MAV20", "age"] <- 49
merge_metadata[merge_metadata$ID == "MAV22", "age"] <- 39
merge_metadata[merge_metadata$ID == "MAV23", "age"] <- 52
merge_metadata[merge_metadata$ID == "MAV24", "age"] <- 35
merge_metadata[merge_metadata$ID == "MAV25", "age"] <- 42
# cambio nome alla colonna age in age_at_t0
names(merge_metadata)[names(merge_metadata) == "age"] <- "age_at_t0"
merge_metadata$age_at_t0 <- as.numeric(merge_metadata$age_at_t0)
# completo la colonna naive
merge_metadata$ID[is.na(merge_metadata$naive)]
merge_metadata[merge_metadata$ID %in% c("MAV08", "MAV12", "MAV15", "MAV20", "MAV24"), "naive"] <- "No"
merge_metadata[merge_metadata$ID %in% c("MAV16", "MAV22", "MAV23", "MAV25"), "naive"] <- "Yes"
# metto la data_t0 di MAV22 che ho trovato
merge_metadata[merge_metadata$ID == "MAV22", "Data_prelievo_T0"] <- as.Date("2021-11-01")
# modifico il medas in modo che sia numerico (I tre trasformati in NA sono recuperabili dalla tabella originale, es. contattare madre)
merge_metadata$MEDAS[merge_metadata$ID %in% c("MAV10", "MAV19", "MAV21")] <- NA
merge_metadata$MEDAS <- as.numeric(merge_metadata$MEDAS)
# AGGIUNGO DATI TROVATI CON ALESSANDRO IN DATA 02/04
merge_metadata[merge_metadata$ID == "MAV16", c("bmi", "smoking_habit", "physical_activity")] <- list(20.1, "Yes", "partially_active")
merge_metadata[merge_metadata$ID == "MAV12", c("bmi", "smoking_habit", "physical_activity")] <- list(20.3, "No", "partially_active")
merge_metadata[merge_metadata$ID == "MAV15", c("bmi", "smoking_habit", "physical_activity")] <- list(32.0, "Yes", "sedentary")
merge_metadata[merge_metadata$ID == "MAV25", c("bmi", "smoking_habit", "physical_activity")] <- list(25.7, "No", "sedentary")
merge_metadata[merge_metadata$ID == "MAV22", "MEDAS"] <- 42
merge_metadata[merge_metadata$ID == "MAV10", "MEDAS"] <- 35
merge_metadata[merge_metadata$ID == "MAV21", "MEDAS"] <- 35
merge_metadata[merge_metadata$ID == "MAV23", c("bmi", "smoking_habit", "physical_activity")] <- list(20.43, "No", "active")
# MAV DI ALTRI CENTRI
merge_metadata[merge_metadata$ID == "MAV31", c("Data_prelievo_T0", "cambio_terapia", "EDSS_T0", "EDSS_T12", "EDSS_T24", "Data_esordio", "Data_diagnosi", "gc_treatment", "smoking_habit")] <- list(as.Date("2021-07-01"), "No", 2.5, 2.5, 2.5, as.Date("2017-08-07"), as.Date("2017-12-15"), "Negative", "No")
merge_metadata[merge_metadata$ID == "MAV31", c("lesion_burden", "bone_marrow_lesions", "subtentorial_lesions", "gadolinium_contrast", "clinical_presentation", "full_recovery", "lesioni_T12", "relapse_T12", "lesioni_T24", "relapse_T24", "Data_di_nascita", "naive", "previous_therapy", "age_at_t0")] <- list("Yes", "Yes", "Yes", "No", "sensoriale", "No", "Yes", "No", "No", "No", as.Date("1975-10-07"), "No", "Rebif", 46)
merge_metadata[merge_metadata$ID == "MAV32", c("Data_prelievo_T0", "cambio_terapia", "EDSS_T0", "EDSS_T12", "EDSS_T24", "Data_esordio", "Data_diagnosi", "gc_treatment", "smoking_habit")] <- list(as.Date("2021-08-23"), "No", 4, 4, 4, as.Date("2015-07-01"), as.Date("2016-07-01"), "Negative", "Yes")
merge_metadata[merge_metadata$ID == "MAV32", c("lesion_burden", "bone_marrow_lesions", "subtentorial_lesions", "gadolinium_contrast", "clinical_presentation", "full_recovery", "lesioni_T12", "relapse_T12", "lesioni_T24", "relapse_T24", "Data_di_nascita", "naive", "previous_therapy", "age_at_t0")] <- list("Yes", "Yes", "No", "No", "tronco", "Yes", "No", "No", "No", "No", as.Date("1976-01-26"), "No", "Lemtrada", 45)
merge_metadata[merge_metadata$ID == "MAV33", c("Data_prelievo_T0", "cambio_terapia", "EDSS_T0", "EDSS_T12", "EDSS_T24", "Data_esordio", "Data_diagnosi", "gc_treatment", "smoking_habit")] <- list(as.Date("2021-09-06"), "No", 2.5, 2.5, 2.5, as.Date("2021-02-15"), as.Date("2021-08-20"), "Negative", "No")
merge_metadata[merge_metadata$ID == "MAV33", c("lesion_burden", "bone_marrow_lesions", "subtentorial_lesions", "gadolinium_contrast", "clinical_presentation", "full_recovery", "lesioni_T12", "relapse_T12", "lesioni_T24", "relapse_T24", "Data_di_nascita", "naive", "age_at_t0")] <- list("Yes", "Yes", "No", "No", "sensoriale", "Yes", "No", "No", "No", "No", as.Date("1998-11-09"), "Yes", 22)
merge_metadata[merge_metadata$ID == "MAV34", c("Data_prelievo_T0", "EDSS_T0", "EDSS_T12", "EDSS_T24", "Data_esordio", "Data_diagnosi", "gc_treatment")] <- list(as.Date("2022-04-19"), 2, 2, 2, as.Date("2008-01-01"), as.Date("2019-11-01"), "Positive")
merge_metadata[merge_metadata$ID == "MAV34", c("lesion_burden", "bone_marrow_lesions", "gadolinium_contrast", "clinical_presentation", "full_recovery", "lesioni_T12", "relapse_T12", "lesioni_T24", "relapse_T24", "Data_di_nascita", "age_at_t0")] <- list("No", "Yes", "No", "norb/sensoriale", "Yes", "No", "No", "No", "No", as.Date("1987-09-22"), 34)
# creo la colonna age calcolata al giorno d'oggi
merge_metadata$age <- floor(time_length(interval(as.Date(merge_metadata$Data_di_nascita), Sys.Date()), "years"))
View(merge_metadata)
View(metadata_MAV_paper)
View(dati_filtrati_pazienti)
View(metadata_paper)
View(metadata_MAV_paper)
View(merge_metadata)
source("Libraries.R")
merged_data <- read.csv("Input/merged_data.csv")
# metto a posto la tipologia di variabile
cols_date <- c("Data_di_nascita", "Data_esordio", "Data_diagnosi", "Data_prelievo_T0", "data_referto_T6", "data_referto_T12", "data_referto_T18", "data_referto_T24", "data_referto_T30", "data_referto_T36", "data_cambio_terapia", "sample_collection_date", "glc_date_before_t0")
merged_data[cols_date] <- lapply(merged_data[cols_date], as.Date)
cols_factor <- c("lesioni_T6", "relapse_T6", "lesioni_T12", "relapse_T12",
"lesioni_T18", "relapse_T18", "lesioni_T24", "relapse_T24",
"lesioni_T30", "relapse_T30", "lesioni_T36", "relapse_T36",
"cambio_terapia", "lesion_burden", "bone_marrow_lesions",
"subtentorial_lesions", "gadolinium_contrast", "full_recovery", "naive", "smoking_habit", "antibiotic_use", "spike_in")
merged_data <- merged_data %>%
mutate(
across(all_of(cols_factor), ~ case_when(
.x %in% c("No", "0", 0) ~ "No",
.x %in% c("Yes", "1", 1) ~ "Yes",
TRUE ~ NA_character_
) %>% factor(levels = c("No", "Yes"))))
knitr::opts_chunk$set(echo = TRUE)
source("Libraries.R")
merged_data <- read.csv("Input/merged_data.csv")
# metto a posto la tipologia di variabile
cols_date <- c("Data_di_nascita", "Data_esordio", "Data_diagnosi", "Data_prelievo_T0", "data_referto_T6", "data_referto_T12", "data_referto_T18", "data_referto_T24", "data_referto_T30", "data_referto_T36", "data_cambio_terapia", "sample_collection_date", "glc_date_before_t0")
merged_data[cols_date] <- lapply(merged_data[cols_date], as.Date)
cols_factor <- c("lesioni_T6", "relapse_T6", "lesioni_T12", "relapse_T12",
"lesioni_T18", "relapse_T18", "lesioni_T24", "relapse_T24",
"lesioni_T30", "relapse_T30", "lesioni_T36", "relapse_T36",
"cambio_terapia", "lesion_burden", "bone_marrow_lesions",
"subtentorial_lesions", "gadolinium_contrast", "full_recovery", "naive", "smoking_habit", "antibiotic_use", "spike_in")
merged_data <- merged_data %>%
mutate(
across(all_of(cols_factor), ~ case_when(
.x %in% c("No", "0", 0) ~ "No",
.x %in% c("Yes", "1", 1) ~ "Yes",
TRUE ~ NA_character_
) %>% factor(levels = c("No", "Yes"))))
cols_factor2 <- c("glucocorticoid_treatment", "gc_treatment", "prognosis_at_onset")
merged_data[cols_factor2] <- lapply(merged_data[cols_factor2], factor, levels = c("Positive", "Negative"))
merged_data$physical_activity <- factor(merged_data$physical_activity, levels = c("active", "sedentary", "partially_active"))
merged_data$simplified_batch <- factor(merged_data$simplified_batch, levels = c("1-3", "4-5"))
merged_data$disease_activity <- factor(merged_data$disease_activity, levels = c("higher_activity", "lower_activity"))
merged_data$sex <- factor(merged_data$sex, levels = c("M", "F"))
merged_data$sequencing_batch <- factor(merged_data$sequencing_batch, levels = c("1", "2", "3"))
merged_data$CENTRO <- factor(merged_data$CENTRO, levels = c("CLERICO", "NAPOLI", "MOLINETTE", "CRESM"))
merged_data$clinical_presentation <- factor(merged_data$clinical_presentation)
merged_data <- merged_data %>%
mutate(across(starts_with("EDSS"), ~ {x_char <- trimws(as.character(.x))
ordered(x_char, levels = as.character(seq(0, 10, by = 0.5)))}))
cols_numeric <- c("MEDAS", "cortisone_T6", "cortisone_T12", "cortisone_T18", "cortisone_T24", "cortisone_T30", "cortisone_T36", "age_at_t0", "bmi", "dna_quantification", "days_gc_collection", "percent_th17", "treg_il10_pos", "treg_cd39_pos", "age")
merged_data[cols_numeric] <- lapply(merged_data[cols_numeric], as.numeric)
# Pulizia x evitare crash LaTeX
merged_data$NOTE <- gsub("[#$%&_]", " ", merged_data$NOTE)
merged_data$nuova_terapia <- gsub("[#$%&_]", " ", merged_data$nuova_terapia)
merged_data$previous_therapy <- gsub("[#$%&_]", " ", merged_data$previous_therapy)
summary(merged_data)
####tabella riassuntiva stile paper
#variabili numeriche
tab_num <- merged_data %>%
dplyr::select(where(is.numeric)) %>%
dplyr::select(-any_of(c("percent_th17", "treg_cd39_pos", "treg_il10_pos"))) %>%
tidyr::pivot_longer(everything(), names_to = "variable", values_to = "val") %>%
mutate(variable = factor(variable, levels = unique(names(merged_data)))) %>%
dplyr::group_by(variable) %>%
dplyr::summarise(
All = paste0(round(mean(val, na.rm = TRUE), 2), " ± ", round(sd(val, na.rm = TRUE), 2)),
`N missing` = as.character(sum(is.na(val))),
.groups = "drop"
)
#variabili categoriche
vars_cat <- merged_data %>%
dplyr::select(where(~is.factor(.) | is.character(.) | is.ordered(.)),
-any_of(c("ID", "NOTE", "nuova_terapia", "previous_therapy", "sample_type"))) %>%
colnames()
lista_cat <- lapply(vars_cat, function(v) {
miss_count <- as.character(sum(is.na(merged_data[[v]])))
levels_df <- merged_data %>%
dplyr::group_by(level = as.character(!!sym(v))) %>%
dplyr::summarise(n = n(), .groups = "drop") %>%
dplyr::filter(!is.na(level)) %>%
dplyr::mutate(
All = paste0(n, " (", round((n / nrow(merged_data)) * 100, 1), "%)"),
`N missing` = ""
) %>%
dplyr::mutate(variable = paste0("   ", level)) %>%
dplyr::select(variable, All, `N missing`)
bind_rows(
tibble(variable = v, All = "", `N missing` = miss_count),
levels_df
)
})
tab_cat <- bind_rows(lista_cat)
#unione
summary_table <- bind_rows(tab_num, tab_cat)
#tolgo underscore nei nomi delle variabili
summary_table$variable <- gsub("_", " ", summary_table$variable)
#visualizzazione nella parte di testo
knitr::kable(summary_table, booktabs = TRUE, longtable = TRUE, caption = "Cohort Summary Table")
ggplot(merged_data, aes(x = EDSS_T0)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T0", x = "EDSS T0", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T6)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T6", x = "EDSS T6", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T12)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T12", x = "EDSS T12", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T18)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T18", x = "EDSS T18", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T24)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T24", x = "EDSS T24", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T30)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T30", x = "EDSS T30", y = "Frequency")
ggplot(merged_data, aes(x = EDSS_T36)) + geom_bar(fill = "#4C78A8", color = "white", linewidth = 0.4) + theme_minimal() + labs(title = "Distribution EDSS T36", x = "EDSS T36", y = "Frequency")
#Preparazione dati
edss_long <- merged_data %>%
select(ID, starts_with("EDSS_T")) %>%
pivot_longer(cols = starts_with("EDSS_T"), names_to = "timepoint", values_to = "EDSS") %>%
filter(!is.na(EDSS)) %>%
mutate(timepoint = factor(timepoint,
levels = paste0("EDSS_T", c(0, 6, 12, 18, 24, 30, 36)),
labels = paste0("T", c(0, 6, 12, 18, 24, 30, 36))))
#linepoint
ggplot(edss_long, aes(x = timepoint, y = EDSS, group = ID)) +
#Linee pazienti
geom_line(aes(color = ID), alpha = 0.4, size = 0.5) +
#jitter per più pazienti sullo stesso valore
geom_point(aes(color = ID), alpha = 0.4, size = 1.2, position = position_jitter(width = 0.1, height = 0, seed = 42)) +
#Linea media
stat_summary(aes(group = 1), fun = mean, geom = "line", size = 1.3, color = "black") +
stat_summary(aes(group = 1), fun = mean, geom = "point", size = 2.5, color = "black", shape = 18) + scale_color_viridis_d(guide = "none") +
labs(title = "EDSS Progression Over Time", subtitle = "Black: cohort average | Coloured: each patient", x = "Timepoints", y = "EDSS value" ) + theme_minimal(base_size = 12) +
theme(panel.grid.minor = element_blank(), axis.title = element_text(face = "bold"), plot.title = element_text(face = "bold", size = 14), plot.subtitle = element_text(color = "grey30"))
# EDSS vs age_at_t0
cor.test(merged_data$age_at_t0, as.numeric(merged_data$EDSS_T0), method = "spearman", exact = FALSE) # non significativo
cor.test(merged_data$age_at_t0, as.numeric(merged_data$EDSS_T12), method = "spearman", exact = FALSE) # non significativo
cor.test(merged_data$age_at_t0, as.numeric(merged_data$EDSS_T24), method = "spearman", exact = FALSE) #SIGNIFICATIVO
cor.test(merged_data$age_at_t0, as.numeric(merged_data$EDSS_T30), method = "spearman", exact = FALSE) #SIGNIFICATIVO
# linee di regressione EDSS vs age_at_t0
ggplot(merged_data, aes(x = age_at_t0, y = as.numeric(as.character(EDSS_T0)))) + geom_point(size = 3, alpha = 0.8) + geom_smooth(method = "lm", se = TRUE) + theme_minimal() + labs(title = "EDSS vs Age at T0", x = "Age at T0", y = "EDSS T0")
ggplot(merged_data, aes(x = age_at_t0, y = as.numeric(as.character(EDSS_T24)))) + geom_point(size = 3, alpha = 0.8) + geom_smooth(method = "lm", se = TRUE) + theme_minimal() + labs(title = "EDSS vs Age at T0", x = "Age at T0", y = "EDSS T24")
# EDSS vs sex ##correlazione non significativa in nessun timepoint
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ sex, data = merged_data, exact = FALSE) # differenza non significativa
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ sex, data = merged_data, exact = FALSE) # differenza non significativa
merged_data$bmi_class <- factor(case_when(
merged_data$bmi < 18.5 ~ "Underweight",
merged_data$bmi >= 18.5 & merged_data$bmi < 25 ~ "Normal_weight",
merged_data$bmi >= 25 & merged_data$bmi < 30 ~ "Overweight",
merged_data$bmi >= 30 ~ "Obese",
TRUE ~ NA_character_),
levels = c("Underweight", "Normal_weight", "Overweight", "Obese"),ordered = TRUE)
ggplot(merged_data, aes(x = bmi_class)) + geom_bar(fill = "#4C78A8", color = "white") + theme_minimal()
# EDSS vs bmi
cor.test(merged_data$bmi, as.numeric(merged_data$EDSS_T0), method = "spearman", exact = FALSE)
cor.test(merged_data$bmi, as.numeric(merged_data$EDSS_T12), method = "spearman", exact = FALSE)
# EDSS vs smoking_habit #correlazione non significativa in nessun timepoint
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ smoking_habit, data = merged_data, exact = FALSE) # differenza non significativa
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ smoking_habit, data = merged_data, exact = FALSE) # differenza non significativa
ggplot(subset(merged_data, !is.na(smoking_habit) & !is.na(EDSS_T0)), aes(x = smoking_habit, y = as.numeric(as.character(EDSS_T0)), fill = smoking_habit)) + geom_boxplot(alpha = 0.8) + theme_minimal() + labs(title = "EDSS vs Smoking habit", x = "Smoking habit", y = "EDSS T0")
## EDSS vs physical_activity
#T0
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ physical_activity, data = merged_data)
ggplot(subset(merged_data, !is.na(physical_activity) & !is.na(EDSS_T0)), aes(x = physical_activity, y = as.numeric(as.character(EDSS_T0)), fill = physical_activity)) + geom_boxplot() + theme_minimal() + labs(title = "EDSS vs Physical_activity", x = "Physical_activity", y = "EDSS_T0")
kruskal.test(as.numeric(as.character(EDSS_T6)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T12)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T18)) ~ physical_activity, data = merged_data)
#T24
kruskal.test(as.numeric(as.character(EDSS_T24)) ~ physical_activity, data = merged_data)
ggplot(subset(merged_data, !is.na(physical_activity) & !is.na(EDSS_T24)), aes(x = physical_activity, y = as.numeric(as.character(EDSS_T24)), fill = physical_activity)) + geom_boxplot() + theme_minimal() + labs(title = "EDSS vs Physical_activity", x = "Physical_activity", y = "EDSS_T24")
kruskal.test(as.numeric(as.character(EDSS_T30)) ~ physical_activity, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T36)) ~ physical_activity, data = merged_data)
#andamento totale
edss_long <- merged_data %>%
select(ID, smoking_habit, sex, naive, physical_activity, EDSS_T0, EDSS_T6, EDSS_T12, EDSS_T18, EDSS_T24, EDSS_T30) %>%
pivot_longer(cols = starts_with("EDSS"), names_to = "time", values_to = "EDSS_val") %>%
mutate(EDSS_val = as.numeric(as.character(EDSS_val)), sex = trimws(as.character(sex)), time = factor(time, levels = c("EDSS_T0","EDSS_T6","EDSS_T12","EDSS_T18","EDSS_T24","EDSS_T30"))) %>%
filter(!is.na(EDSS_val))
ggplot(edss_long, aes(x = time, y = EDSS_val, color = physical_activity, group = physical_activity)) +
stat_summary(fun = median, geom = "line", linewidth = 1.2, na.rm = TRUE) +
stat_summary(fun = median, geom = "point", size = 3, na.rm = TRUE) +
theme_minimal() + labs(title="EDSS during time by Physical Activity", x = "Time", y = "Median EDSS")
merged_data$MEDAS_class <- factor(case_when(
merged_data$MEDAS < 40 ~ "Low_adherence",
merged_data$MEDAS >= 40 & merged_data$MEDAS < 60 ~ "Moderate_adherence",
merged_data$MEDAS >= 60 ~ "High_adherence",
TRUE ~ NA_character_),
levels = c("Low_adherence", "Moderate_adherence", "High_adherence"),ordered = TRUE)
ggplot(merged_data, aes(x = MEDAS_class)) + geom_bar(fill = "#4C78A8", color = "white") + theme_minimal() + labs(title = "MEDAS adherence categories", x = "Adherence level", y = "Frequency")
# EDSS vs MEDAS
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T12)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T24)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T36)) ~ MEDAS, data = merged_data)
# age_at_t0 vs relapse
t.test(age_at_t0 ~ relapse_T6, data = merged_data)
t.test(age_at_t0 ~ relapse_T24, data = merged_data)
# age_at_t0 vs lesions
t.test(age_at_t0 ~ lesioni_T6, data = merged_data) # correlazione SIGNIFICATIVA (di poco)
t.test(age_at_t0 ~ lesioni_T12, data = merged_data) # correlazione SIGNIFICATIVA
t.test(age_at_t0 ~ lesioni_T24, data = merged_data) # correlazione non significativa
#lesion burden
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ lesion_burden, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ lesion_burden, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T0), !is.na(lesion_burden)) %>%
mutate(
EDSS_T0 = as.factor(EDSS_T0),
lesion_burden = factor(lesion_burden, labels = c("No", "Yes"))) %>%
ggplot(aes(x = lesion_burden, fill = EDSS_T0)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T0 by lesion burden", x = "Lesion burden", y = "Percentage", fill = "EDSS")
#Bone marrow lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T0), !is.na(bone_marrow_lesions)) %>%
mutate(
EDSS_T0 = as.factor(EDSS_T0),
bone_marrow_lesions = factor(bone_marrow_lesions, labels = c("No", "Yes"))) %>%
ggplot(aes(x = bone_marrow_lesions, fill = EDSS_T0)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T0 by bone marrow lesions", x = "Bone marrow lesions", y = "Percentage", fill = "EDSS")
#subtentorial lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
#gadolinium contrast
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
#glucocorticoid treatment before T0 e edss T0 #SIGNIFICATIVO
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gc_treatment, data = merged_data)
ggplot(merged_data, aes(x = gc_treatment, y = as.numeric(as.character(EDSS_T0)))) + geom_boxplot() + theme_minimal() + labs(title= "Glucocorticoid treatment before T0", x= "gc treatment", y="EDSS T0")
str(merged_data)
