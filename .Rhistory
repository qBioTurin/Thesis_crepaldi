kruskal.test(as.numeric(as.character(EDSS_T36)) ~ physical_activity, data = merged_data)
#andamento totale
edss_long <- merged_data %>%
select(ID, smoking_habit, sex, naive, physical_activity, EDSS_T0, EDSS_T6, EDSS_T12, EDSS_T18, EDSS_T24, EDSS_T30) %>%
pivot_longer(cols = starts_with("EDSS"), names_to = "time", values_to = "EDSS_val") %>%
mutate(EDSS_val = as.numeric(as.character(EDSS_val)), sex = trimws(as.character(sex)), time = factor(time, levels = c("EDSS_T0","EDSS_T6","EDSS_T12","EDSS_T18","EDSS_T24","EDSS_T30"))) %>%
filter(!is.na(EDSS_val))
ggplot(edss_long, aes(x = time, y = EDSS_val, color = physical_activity, group = physical_activity)) +
stat_summary(fun = median, geom = "line", linewidth = 1.2, na.rm = TRUE) +
stat_summary(fun = median, geom = "point", size = 3, na.rm = TRUE) +
theme_minimal() + labs(title="EDSS during time by Physical Activity", x = "Time", y = "Median EDSS")
merged_data$MEDAS_class <- factor(case_when(
merged_data$MEDAS < 40 ~ "Low_adherence",
merged_data$MEDAS >= 40 & merged_data$MEDAS < 60 ~ "Moderate_adherence",
merged_data$MEDAS >= 60 ~ "High_adherence",
TRUE ~ NA_character_),
levels = c("Low_adherence", "Moderate_adherence", "High_adherence"),ordered = TRUE)
ggplot(merged_data, aes(x = MEDAS_class)) + geom_bar(fill = "#4C78A8", color = "white") + theme_minimal() + labs(title = "MEDAS adherence categories", x = "Adherence level", y = "Frequency")
# EDSS vs MEDAS
kruskal.test(as.numeric(as.character(EDSS_T0)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T12)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T24)) ~ MEDAS, data = merged_data)
kruskal.test(as.numeric(as.character(EDSS_T36)) ~ MEDAS, data = merged_data)
# age_at_t0 vs relapse
t.test(age_at_t0 ~ relapse_T6, data = merged_data)
t.test(age_at_t0 ~ relapse_T24, data = merged_data)
# age_at_t0 vs lesions
t.test(age_at_t0 ~ lesioni_T6, data = merged_data) # correlazione SIGNIFICATIVA (di poco)
t.test(age_at_t0 ~ lesioni_T12, data = merged_data) # correlazione SIGNIFICATIVA
t.test(age_at_t0 ~ lesioni_T24, data = merged_data) # correlazione non significativa
#lesion burden
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ lesion_burden, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ lesion_burden, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T0), !is.na(lesion_burden)) %>%
mutate(
EDSS_T0 = as.factor(EDSS_T0),
lesion_burden = factor(lesion_burden, labels = c("No", "Yes"))) %>%
ggplot(aes(x = lesion_burden, fill = EDSS_T0)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T0 by lesion burden", x = "Lesion burden", y = "Percentage", fill = "EDSS")
#Bone marrow lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ bone_marrow_lesions, data = merged_data, exact = FALSE)
merged_data %>%
filter(!is.na(EDSS_T12), !is.na(bone_marrow_lesions)) %>%
mutate(
EDSS_T12 = as.factor(EDSS_T12),
bone_marrow_lesions = factor(bone_marrow_lesions, labels = c("No", "Yes"))) %>%
ggplot(aes(x = bone_marrow_lesions, fill = EDSS_T12)) +
geom_bar(position = "fill") + scale_y_continuous(labels = scales::percent) +
scale_fill_viridis_d(option = "mako") + theme_minimal() + labs(title = "EDSS T12 by bone marrow lesions", x = "Bone marrow lesions", y = "Percentage", fill = "EDSS")
#subtentorial lesions
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ subtentorial_lesions, data = merged_data, exact = FALSE)
#gadolinium contrast
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
wilcox.test(as.numeric(as.character(EDSS_T12)) ~ gadolinium_contrast, data = merged_data, exact = FALSE)
#glucocorticoid treatment before T0 e edss T0 #SIGNIFICATIVO
wilcox.test(as.numeric(as.character(EDSS_T0)) ~ gc_treatment, data = merged_data)
ggplot(merged_data, aes(x = gc_treatment, y = as.numeric(as.character(EDSS_T0)))) + geom_boxplot() + theme_minimal() + labs(title= "Glucocorticoid treatment before T0", x= "gc treatment", y="EDSS T0")
source("Libraries.R")
merged_data <- read.csv("Input/merged_data.csv")
View(merged_data)
filtered_patients <- merged_data %>%
filter(ID %in% c("MAV05", "MAV07", "MAV09", "MAV11", "MAV13", "MAV14")) %>%
distinct(ID, .keep_all = TRUE)
filtered_patients <- filtered_patients %>%
pivot_longer(
cols = matches("^(EDSS|lesioni|relapse|cortisone)_"),
names_to = c(".value", "tp"),
names_sep = "_"
) %>%
filter(tp %in% c("T0", "T12")) %>%
bind_rows(filter(., tp == "T0") %>% mutate(tp = "T3")) %>%
mutate(tp = factor(tp, levels = c("T0", "T3", "T12"))) %>%
arrange(ID, tp) %>%
group_by(ID) %>%
mutate(
EDSS_trend = case_when(
tp != "T3" ~ NA_character_,
EDSS[tp == "T12"] == EDSS[tp == "T0"] ~ "stable",
EDSS[tp == "T12"] > EDSS[tp == "T0"]  ~ "worsening",
EDSS[tp == "T12"] < EDSS[tp == "T0"]  ~ "improvement",
TRUE ~ NA_character_
)
) %>%
ungroup() %>%
mutate(sample = paste0(ID, tp)) %>%
rename(original = ID) %>%
rename(id = sample) %>%
select(id, everything()) %>%
select(where(~ !all(is.na(.))))
View(filtered_patients)
merged_data <- read.csv("Input/merged_data.csv")
batch_data <- readxl::read_excel("Input/batch_sequenziamento.xlsx",skip = 1) %>%
select(ID, sequencing_batch) %>%
rename(id = ID)
View(batch_data)
filtered_patients <- merged_data %>%
filter(ID %in% c("MAV05", "MAV07", "MAV09", "MAV11", "MAV13", "MAV14", "MAV34")) %>%
distinct(ID, .keep_all = TRUE)
filtered_patients <- filtered_patients %>%
pivot_longer(
cols = matches("^(EDSS|lesioni|relapse|cortisone)_"),
names_to = c(".value", "tp"),
names_sep = "_"
) %>%
filter(tp %in% c("T0", "T12")) %>%
bind_rows(filter(., tp == "T0") %>% mutate(tp = "T3")) %>%
mutate(tp = factor(tp, levels = c("T0", "T3", "T12"))) %>%
arrange(ID, tp) %>%
group_by(ID) %>%
mutate(
EDSS_trend = case_when(
tp != "T3" ~ NA_character_,
EDSS[tp == "T12"] == EDSS[tp == "T0"] ~ "stable",
EDSS[tp == "T12"] > EDSS[tp == "T0"]  ~ "worsening",
EDSS[tp == "T12"] < EDSS[tp == "T0"]  ~ "improvement",
TRUE ~ NA_character_
)
) %>%
ungroup() %>%
mutate(sample = paste0(ID, tp)) %>%
rename(original = ID) %>%
rename(id = sample) %>%
select(id, everything()) %>%
select(where(~ !all(is.na(.)))) %>%
left_join(batch_data, by = "id")
View(filtered_patients)
