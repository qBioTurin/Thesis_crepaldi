sex,
age_at_t0
) %>%
na.omit()
# modello cox ridotto — SOLO VARIABILI NON CLINICHE
cox_neda3 <- coxph(
Surv(time_followup, status_NEDA3) ~
gc_at_least + lesion_burden + gadolinium_contrast +
bone_marrow_lesions + subtentorial_lesions + sex + age_at_T0,
data = df_cox
)
