)
merged <- merged %>%
mutate(
sub_group = case_when(
GROUP == "MAV" &
subtentorial_lesions == "Yes" ~ "MAV subt +",
GROUP == "MAV" &
subtentorial_lesions == "No" ~ "MAV subt -",
GROUP == "TEC" &
subtentorial_lesions == "Yes" ~ "TEC subt +",
GROUP == "TEC" &
subtentorial_lesions == "No" ~ "TEC subt -"
)
)
surv_obj11 <- Surv(time = merged$time_CT, event = merged$event_status_CT)
fit11 <- survfit(surv_obj11 ~ sub_group, data = merged)
ggsurvplot(
fit11,
data = merged,
risk.table = FALSE,
pval = TRUE,
conf.int = FALSE,
legend.title = "Groups",
legend.labs = c("MAV subt+", "MAV subt-", "TEC subt+", "TEC subt-"),
xlab = "Months",
ylab = "Event-free survival"
)
#spacchretto mav
merged_MAV <- merged %>%
filter(GROUP == "MAV")
surv_obj_MAV <- Surv(
time = merged_MAV$time_CT,
event = merged_MAV$event_status_CT
)
fit_MAV <- survfit(
surv_obj_MAV ~ sub_group,
data = merged_MAV
)
ggsurvplot(
fit_MAV,
data = merged_MAV,
risk.table = FALSE,
pval = TRUE,
conf.int = FALSE,
legend.title = "Subtentorial",
legend.labs = c("MAV sub +", "MAV sub -"),
xlab = "Months",
ylab = "Event-free survival",
title = "MAV"
)
#spacchetto tec
merged_TEC <- merged %>%
filter(GROUP == "TEC")
surv_obj_TEC <- Surv(
time = merged_TEC$time_CT,
event = merged_TEC$event_status_CT
)
fit_TEC <- survfit(
surv_obj_TEC ~ sub_group,
data = merged_TEC
)
ggsurvplot(
fit_TEC,
data = merged_TEC,
risk.table = FALSE,
pval = TRUE,
conf.int = FALSE,
legend.title = "Subtentorial",
legend.labs = c("TEC sub +", "TEC sub -"),
xlab = "Months",
ylab = "Event-free survival",
title = "TEC"
)
