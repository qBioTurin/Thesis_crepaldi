scale_x_continuous(limits = c(-max_abs_coef, max_abs_coef)) +
labs(
x = "Beta coefficient",
y = "Species",
title = "Significant Eukaryota abundance (qvalue)"
) +
theme_classic()
View(significant_eukaryota_abundance_qvalue)
