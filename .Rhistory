merged <- merged %>%
mutate(
edss_event_6  = (EDSS_T6  - EDSS_T0)  >= 0.5,
edss_event_12 = (EDSS_T12 - EDSS_T6)  >= 0.5,
edss_event_18 = (EDSS_T18 - EDSS_T12) >= 0.5,
edss_event_24 = (EDSS_T24 - EDSS_T18) >= 0.5,
