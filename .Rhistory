# 1. Carica e filtra i pazienti
merged_data <- read.csv("Input/merged_data.csv")
filtered_patients <- merged_data %>%
filter(ID %in% c("MAV05", "MAV07", "MAV09", "MAV11", "MAV13", "MAV14", "MAV34")) %>%
distinct(ID, tp, .keep_all = TRUE) # Nota: ho aggiunto 'tp' per non perdere i vari timepoint dello stesso paziente
# 2. Filtra i pazienti (senza toccare nulla per ora)
filtered_patients <- merged_data %>%
filter(ID %in% c("MAV05", "MAV07", "MAV09", "MAV11", "MAV13", "MAV14", "MAV34")) %>%
distinct(ID, .keep_all = TRUE)
# 3. Trasformazione completa e calcolo del trend
filtered_patients <- filtered_patients %>%
# Questo crea la colonna 'tp' e unifica EDSS, lesioni, relapse, cortisone
pivot_longer(
cols = matches("^(EDSS|lesioni|relapse|cortisone)_"),
names_to = c(".value", "tp"),
names_sep = "_"
) %>%
# Teniamo solo T0 e T12 (elimina T6 o altri timepoint se presenti nelle colonne)
filter(tp %in% c("T0", "T12")) %>%
# Duplica le righe del T0 per creare il T3
bind_rows(
filter(., tp == "T0") %>% mutate(tp = "T3")
) %>%
# Ordina cronologicamente: T0 -> T3 -> T12
mutate(tp = factor(tp, levels = c("T0", "T3", "T12"))) %>%
arrange(ID, tp) %>%
# Calcola il trend EDSS solo nella riga T3
group_by(ID) %>%
mutate(
EDSS_trend = case_when(
tp != "T3" ~ NA_character_,
EDSS[tp == "T12"] == EDSS[tp == "T0"] ~ "stable",
EDSS[tp == "T12"] > EDSS[tp == "T0"]  ~ "worsening",
EDSS[tp == "T12"] < EDSS[tp == "T0"]  ~ "improvement",
TRUE ~ NA_character_
)
) %>%
ungroup()
View(filtered_patients)
