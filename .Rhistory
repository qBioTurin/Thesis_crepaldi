)
merged <- merged %>%
mutate(
edss_event_time = case_when(
edss_event_6  ~ 6,
edss_event_12 ~ 12,
edss_event_18 ~ 18,
edss_event_24 ~ 24,
edss_event_30 ~ 30,
edss_event_36 ~ 36,
TRUE ~ NA_real_
),
edss_event_status = ifelse(is.na(edss_event_time), 0, 1),
edss_time = ifelse(is.na(edss_event_time), 36, edss_event_time)
)
surv_edss <- Surv(merged$edss_time, merged$edss_event_status)
