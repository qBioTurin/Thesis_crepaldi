main_el= "tp"
confunders = c("sex", "bmi", "age_at_t0")
output_folder= "C:/Users/gialu/Desktop/tesi_magistrale/Analisi_pts_completi_app/Risultati_Maaslin/Risultati_MAV_app/Risultati_maaslin_eukaryota"
#QUI CAMBIA IL PERCORSO DELL'RDS DI INTERESSE
rds = readRDS("C:\\Users\\gialu\\Desktop\\tesi_magistrale\\Analisi_pts_completi_app\\Risultati_Maaslin\\Risultati_MAV_app\\shared_results\\SUPERVISED_DEC\\Eukaryota_Supervised_decontam.rds")
otu <- rds@otu_table
taxa <- rds@tax_table
metadata_df <- as(rds@sam_data, "data.frame")
unique(metadata_df$tp)
taxa <- as.data.frame(taxa)
taxa$Genus_Species <- paste(taxa$Genus, taxa$Species, sep = "_")
Tnew <- taxa %>% select(Genus_Species)
Tnew$taxid <- rownames(Tnew)
if (confunders %>% length() == 0) {
formulaInUse <- main_el
} else {
formulaInUse <- paste(main_el, paste(confunders, collapse = "+"), sep = "+")
}
otu <- as.data.frame(otu)
otu$taxid <- rownames(otu)
# Merge the two data frames by taxid
merged_df <- merge(otu, Tnew, by = "taxid")
rownames(merged_df) <- merged_df$Genus_Species
merged_df <- merged_df %>% select(-c(taxid, Genus_Species))
merged_df <- t(merged_df)
metadata_df$tp <- factor(
as.character(metadata_df$tp),
levels = c("T0", "T3", "T12", "T15", "T24", "T36"),
ordered = FALSE
)
unique(metadata_df$tp)
metadata_df$sex = as.factor(metadata_df$sex)
levels(metadata_df$sex) = c("M", "F")
metadata_df$lesioni =as.factor(metadata_df$lesioni)
levels(metadata_df$lesioni) = c("Yes", "No")
metadata_df$relapse =as.factor(metadata_df$relapse)
levels(metadata_df$relapse) = c("Yes", "No")
if (!dir.exists(output_folder)) {
dir.create(output_folder, recursive = TRUE)
}
coef_plot_vars <- c("tp T3", "tp T12", "tp T15", "tp T24", "tp T36")
discr_els_formatted <- unlist(lapply(confunders, function(d) {
if (is.factor(metadata_df[[d]])) {
paste(d, levels(metadata_df[[d]])) # tutti i livelli
} else {
d # continuous
}
}))
##for stability of results across runs
formulaInUse_fin = paste0("~ ",formulaInUse, "+(1|original)")
set.seed(2204)
median_comparison_abundance_in = FALSE
fx_effects = NULL
random_effects =  NULL
group_effects = NULL
ordered_effects = NULL
strata_effects = NULL
Sys.setenv(OMP_NUM_THREADS=1, MKL_NUM_THREADS=1, OPENBLAS_NUM_THREADS=1)
fit_out <- maaslin3(
input_data = merged_df,
input_metadata = metadata_df,
output = output_folder,
formula = formulaInUse_fin,
fixed_effects = fx_effects,
plot_summary_plot = TRUE,
reference = c('tp,T0'),
standardize= TRUE,#o continuous guardare se standardizzare o meno le variabili continue
coef_plot_vars = coef_plot_vars,
random_effects = random_effects,
group_effects = group_effects,
ordered_effects = ordered_effects,
strata_effects = strata_effects,
normalization = "TSS",
heatmap_vars = c("tp T3", "tp T12", "tp T15", "tp T24", "tp T36", "sex F", "bmi", "age_at_t0"),
transform = "LOG",
augment = TRUE,
max_significance = 0.1,
median_comparison_abundance = median_comparison_abundance_in,
median_comparison_prevalence = FALSE,
max_pngs = 30,
summary_plot_first_n = 200,
# pval_filter = 0.05,
cores = 1
)
######risultati con pazienti totali#####
#batteri
all_definitive_bacteria = read.delim("C:\\Users\\gialu\\Desktop\\tesi_magistrale\\Analisi_pts_completi_app\\Risultati_Maaslin\\Risultati_MAV_app\\risultati_maaslin_bacteria\\all_results.tsv")
significant_bacteria_prevalence_pvalue <- all_definitive_bacteria %>%
filter(model == "prevalence", metadata == "tp",
pval_individual < 0.05)
significant_bacteria_prevalence_qvalue <- all_definitive_bacteria %>%
filter(model == "prevalence", metadata == "tp", qval_individual < 0.1)
significant_bacteria_abundance_pvalue <- all_definitive_bacteria %>%
filter(model == "abundance", metadata == "tp",
pval_individual < 0.05)
significant_bacteria_abundance_qvalue <- all_definitive_bacteria %>%
filter(model == "abundance", metadata == "tp",
qval_individual < 0.1)
View(significant_bacteria_abundance_qvalue)
#batteri prevalence pvalue
significant_bacteria_prevalence_pvalue$neg_log10_p <- -log10(significant_bacteria_prevalence_pvalue$pval_individual)
max_abs_coef <- max(abs(significant_bacteria_prevalence_pvalue$coef), na.rm = TRUE)
ggplot(significant_bacteria_prevalence_pvalue,
aes(y = reorder(feature, -pval_individual))) +
geom_segment(aes(x = 0,
xend = coef,
yend = reorder(feature, -pval_individual)),
color = "grey70",
linewidth = 0.8) +
geom_point(aes(x = coef,
color = neg_log10_p),
size = 4) +
geom_vline(xintercept = 0,
linetype = "dashed",
color = "black") +
scale_color_gradient(low = "lightblue",high = "darkblue",
name = expression(-log[10](p-value))) +
scale_x_continuous(limits = c(-max_abs_coef, max_abs_coef)) +
labs(
x = "Beta coefficient",
y = "Species",
title = "Significant Bacteria prevalence (pvalue)"
) +
theme_classic()
# ci sono davvero feature duplicate?
dup_check <- significant_bacteria_prevalence_pvalue %>%
count(feature) %>%
filter(n > 1)
View(dup_check)
# guarda le righe complete di quelle feature duplicate
all_definitive_bacteria %>%
filter(feature %in% dup_check$feature, metadata == "tp") %>%
select(feature, model, metadata, value, coef, pval_individual)
significant_bacteria_prevalence_pvalue %>%
arrange(pval_individual) %>%
select(feature, coef, pval_individual, N, N.not.zero) %>%
head(10)
