# 16. GRIGLIA ORIGINALE 2 × 4
############################################################
association_grid_original <- plot_grid(
association_collinsella,
association_segatella,
associations_eggerthella,
association_gordonibacter,
association_bifidobacterium,
association_coprococcus,
association_alistipes,
association_parabacteroides,
ncol = 2,
nrow = 4,
align = "hv"
)
############################################################
# 17. RIDIMENSIONAMENTO DEI GRAFICI HD
############################################################
# Gli HD rimangono più piccoli dei grafici principali
association_HD_collinsella_small <- ggdraw() +
draw_plot(
association_HD_collinsella,
x = 0.10,
y = 0.07,
width = 0.85,
height = 0.75
)
association_HD_bifidobacterium_small <- ggdraw() +
draw_plot(
association_HD_bifidobacterium,
x = 0.10,
y = 0.07,
width = 0.80,
height = 0.75
)
############################################################
# 18. COLONNA HD
############################################################
# Righe:
# 1 = HD Collinsella
# 2 = vuoto
# 3 = HD Bifidobacterium
# 4 = vuoto
HD_column <- plot_grid(
association_HD_collinsella_small,
ggdraw(),
association_HD_bifidobacterium_small,
ggdraw(),
ncol = 1,
nrow = 4,
align = "v"
)
############################################################
# 19. UNIONE HD + GRIGLIA PRINCIPALE
############################################################
# La colonna HD viene resa stretta.
# Questo la avvicina alla griglia principale senza
# modificare le dimensioni relative degli 8 grafici.
association_complete_grid <- plot_grid(
HD_column,
association_grid_original,
ncol = 2,
rel_widths = c(0.28, 2),
align = "h"
)
############################################################
# 20. LEGENDA UNICA
############################################################
timepoint_colors <- setNames(
scales::hue_pal()(6),
c("T0", "T3", "T12", "T15", "T24", "T36")
)
legend_df <- data.frame(
x = 1:7,
y = 1,
category = factor(
c(
"T0",
"T3",
"T12",
"T15",
"T24",
"T36",
"HD"
),
levels = c(
"T0",
"T3",
"T12",
"T15",
"T24",
"T36",
"HD"
)
)
)
legend_plot <- ggplot(
legend_df,
aes(x = x, y = y, fill = category)
) +
geom_point(
shape = 22,
size = 5
) +
scale_fill_manual(
name = NULL,
values = c(
timepoint_colors,
"HD" = "#FFF68F"
)
) +
theme_void() +
theme(
legend.position = "right",
legend.text = element_text(size = 20)
)
legend <- get_legend(legend_plot)
############################################################
# 21. ASSOCIAZIONE + LEGENDA
############################################################
association_grid_legend <- plot_grid(
association_complete_grid,
legend,
ncol = 2,
rel_widths = c(1, 0.12)
)
############################################################
# 22. TITOLO GENERALE
############################################################
title <- ggdraw() +
draw_label(
"Bacterial species statistically significant for abundance",
fontface = "bold",
size = 20,
hjust = 0.5
)
############################################################
# 23. COMPOSITO FINALE
############################################################
association_composito_batteri <- plot_grid(
title,
association_grid_legend,
ncol = 1,
rel_heights = c(0.06, 1)
)
############################################################
# 24. SALVATAGGIO
############################################################
ggsave(
"association_composito_batteri_HD_PROVA_ALLARGO.jpeg",
association_composito_batteri,
width = 18,
height = 15,
dpi = 300
)
