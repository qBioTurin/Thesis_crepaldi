n = n(),
.groups = "drop"
) %>%
dplyr::mutate(
All = paste0(n, " (", round((n / nrow(df)) * 100, 1), "%)")
) %>%
dplyr::rowwise() %>%
dplyr::mutate(`N missing` = sum(is.na(df[[Var_Name]]))) %>%
dplyr::ungroup() %>%
dplyr::mutate(Variable = paste0(Var_Name, " [", Level, "]")) %>%
dplyr::select(Variable, All, `N missing`)
)
