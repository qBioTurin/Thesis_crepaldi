library(gtsummary)
library(dplyr)
# ordina: prima numeriche poi categoriche
num_vars <- names(select(merged_data, where(is.numeric)))
cat_vars <- names(select(merged_data, where(~ is.factor(.) || is.character(.))))
ordered_vars <- c(num_vars, cat_vars)
Summary_table <- merged_data %>%
select(all_of(ordered_vars)) %>%
tbl_summary(
statistic = list(
all_continuous() ~ "{mean} ± {sd}",
all_categorical() ~ "{n} ({p}%)"
),
missing = "no"
) %>%
add_n(statistic = "{N_miss}") %>%
modify_header(
label = "**Variabile**",
stat_0 = "**All**",
add_n = "**N missing**"
) %>%
bold_labels()
View(Summary_table)
View(Summary_table)
Summary_table$table_body
library(dplyr)
library(tidyr)
create_summary_table <- function(df) {
result <- data.frame(
Variabile = character(),
All = character(),
N_missing = numeric(),
stringsAsFactors = FALSE
)
# ---------- variabili numeriche ----------
num_vars <- names(df)[sapply(df, is.numeric)]
for (var in num_vars) {
mean_val <- mean(df[[var]], na.rm = TRUE)
sd_val <- sd(df[[var]], na.rm = TRUE)
n_miss <- sum(is.na(df[[var]]))
result <- bind_rows(
result,
data.frame(
Variabile = var,
All = sprintf("%.2f ± %.2f", mean_val, sd_val),
N_missing = n_miss
)
)
}
# ---------- variabili categoriche ----------
cat_vars <- names(df)[sapply(df, function(x) is.factor(x) || is.character(x))]
for (var in cat_vars) {
n_miss <- sum(is.na(df[[var]]))
tab <- table(df[[var]], useNA = "no")
pct <- prop.table(tab) * 100
# riga nome variabile
result <- bind_rows(
result,
data.frame(
Variabile = var,
All = "",
N_missing = n_miss
)
)
# righe livelli
for (lvl in names(tab)) {
result <- bind_rows(
result,
data.frame(
Variabile = paste0("  ", lvl),
All = sprintf("%d (%.1f%%)", tab[[lvl]], pct[[lvl]]),
N_missing = ""
)
)
}
}
return(result)
}
Summary_table <- create_summary_table(merged_data)
create_summary_table(merged_data)
